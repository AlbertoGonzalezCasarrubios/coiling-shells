{
  "name": "coiling-shells",
  "version": "1.3.0",
  "description": "Interactive 3D explorer of Raup's shell-coiling model and Meinhardt's reaction–diffusion pigmentation models.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Alberto González Casarrubios <albert23@ucm.es>",
  "homepage": "https://albertogonzalezcasarrubios.github.io/coiling-shells/",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlbertoGonzalezCasarrubios/coiling-shells.git"
  },
  "bugs": "https://github.com/AlbertoGonzalezCasarrubios/coiling-shells/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:fast": "SKIP_BROWSER=1 node --test",
    "coverage": "SKIP_BROWSER=1 node --test --experimental-test-coverage --test-coverage-include='js/**' --test-coverage-lines=98 --test-coverage-branches=90",
    "lint": "eslint -c config/eslint.config.js . && prettier --check \"**/*.{js,mjs}\" && tsc -p config/jsconfig.json",
    "typecheck": "tsc -p config/jsconfig.json",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "serve": "python3 -m http.server 8000"
  },
  "keywords": [
    "theoretical morphology",
    "Raup",
    "Meinhardt",
    "reaction-diffusion",
    "mollusc shells",
    "morphospace",
    "three.js"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/three": "0.160.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jspdf": "4.2.1",
    "mathjax": "3.2.2",
    "prettier": "3.9.10",
    "three": "0.160.0",
    "typescript": "7.0.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 140
  }
}
